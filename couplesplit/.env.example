# =============================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================
APP_NAME=CoupleSplit
APP_ENV=production
APP_KEY=                        # Gerar com: php artisan key:generate --show
APP_DEBUG=false
APP_URL=                        # URL pública do Railway (ex: https://xxx.railway.app)

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =============================================================
# LOGS
# =============================================================
LOG_CHANNEL=stderr              # Railway exibe logs via stderr
LOG_LEVEL=error

# =============================================================
# BANCO DE DADOS — preencher com as credenciais do Railway MySQL
# =============================================================
DB_CONNECTION=mysql
DB_HOST=                        # MYSQL_HOST fornecido pelo Railway
DB_PORT=3306                    # MYSQL_PORT fornecido pelo Railway
DB_DATABASE=                    # MYSQL_DATABASE fornecido pelo Railway
DB_USERNAME=                    # MYSQL_USER fornecido pelo Railway
DB_PASSWORD=                    # MYSQL_PASSWORD fornecido pelo Railway

# =============================================================
# SESSÃO E CACHE
# =============================================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# =============================================================
# E-MAIL (opcional — configurar se quiser enviar convites)
# =============================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@couplesplit.app"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================
# VITE
# =============================================================
VITE_APP_NAME="${APP_NAME}"
